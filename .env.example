# PhoneWeave control server
PORT=8787
PHONEWEAVE_ADMIN_TOKEN=change-me-admin
PHONEWEAVE_DEVICE_TOKEN=change-me-device
WEB_TOKEN=change-me-web
WEB_SESSION_TTL_SECONDS=43200
PHONEWEAVE_MAX_UPLOAD_BYTES=536870912
PHONEWEAVE_HTTP_REQUEST_TIMEOUT_MS=1800000

# Public URL used in docs/UI. Put your HTTPS address here in production.
PUBLIC_BASE_URL=http://localhost:8787

# ICE servers returned to browser and Android Agent.
STUN_URL=stun:stun.l.google.com:19302
TURN_URL=turn:localhost:3478
TURN_USER=phoneweave
TURN_PASSWORD=change-me-turn
TURN_REALM=phoneweave.local

# Remote TURN deployment. CLOUDFLARE_DOMAIN is the zone/root domain;
# TURN_DOMAIN defaults to turn.${CLOUDFLARE_DOMAIN} when omitted.
PHONEWEAVE_DEPLOY_TARGET=root@your-server-ip
PHONEWEAVE_REMOTE_ROOT=/opt/phoneweave
TURN_DOMAIN=
PHONEWEAVE_CONTROL_DOMAIN=
PHONEWEAVE_CONTROL_PORT=8443
PHONEWEAVE_ANDROID_SERVER_URL=
# Set this only when the SSH target is a hostname or the server is behind NAT.
TURN_EXTERNAL_IP=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_DOMAIN=example.com

# Logging
LOG_LEVEL=info
